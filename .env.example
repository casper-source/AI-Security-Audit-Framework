# Shell variables win over this file. The profile env block names these variables.
TARGET=demo                      # Folder under targets/. Loads targets/<TARGET>/profile.yaml.
TARGET_URL=http://127.0.0.1:8787 # Origin of the system under test. The campaign hash uses the health model, not this URL.
TARGET_KEY=                      # Optional bearer token, sent as Authorization: Bearer.
TARGET_MODEL=                    # Optional model name in the chat body. Not the model id reported by GET /health.

AUDITOR_URL=                     # Optional auditor base. Empty skips the drafter and the rubric. Localhost only unless auditor.remote is true.
AUDITOR_KEY=                     # Optional auditor bearer token. Unused while AUDITOR_URL is empty.
AUDITOR_MODEL=                   # Optional drafter and rubric model. It never decides a hit.
